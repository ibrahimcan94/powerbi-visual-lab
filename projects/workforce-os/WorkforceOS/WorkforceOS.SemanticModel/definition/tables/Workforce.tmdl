	column Included = IF( LOWER(TRIM(Workforce[Exclude from Headcount])) IN { "yes", "true", "1" }, FALSE(), LOWER(TRIM(Workforce[Worker Status])) IN { "active", "on leave" } )
		dataType: boolean
		lineageTag: ca1f5510-4dfc-40c2-9dc6-baca6add70e6
