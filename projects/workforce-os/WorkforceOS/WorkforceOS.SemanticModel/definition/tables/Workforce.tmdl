table Workforce
	lineageTag: 2e55673e-6e59-4a4e-a9ee-3c6348f2e2cb

	measure 'Selected Snapshot' = MAXX(ALLSELECTED(Workforce), Workforce[Snapshot_Date])
		formatString: yyyy-MM-dd
		displayFolder: Workforce Metrics
		lineageTag: 35dc5890-bb35-4874-9460-257893a40e86

	measure 'Included Headcount' = VAR D = [Selected Snapshot] RETURN CALCULATE(DISTINCTCOUNT(Workforce[Workday ID]), Workforce[Snapshot_Date] = D, Workforce[Included] = TRUE())
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: c30ab877-a13f-42f0-a1d4-7e323e21ca8e

	measure 'Total FTE' = VAR D = [Selected Snapshot] RETURN CALCULATE(SUM(Workforce[Full Time Equivalent (FTE)]), Workforce[Snapshot_Date] = D, Workforce[Included] = TRUE())
		formatString: #,0.00
		displayFolder: Workforce Metrics
		lineageTag: 4244fc54-7b3c-49e6-ab0b-026272b8c379

	measure Employees = CALCULATE([Included Headcount], KEEPFILTERS(Workforce[Worker Type] = "Employee"))
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: 73f33b0d-82cc-458e-97a0-f44cba125b54

	measure 'Contingent Workers' = CALCULATE([Included Headcount], KEEPFILTERS(Workforce[Worker Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: 09eee87d-a37d-407e-903e-aeec4b7c59d8

	measure 'People Managers' = CALCULATE([Included Headcount], KEEPFILTERS(Workforce[Is Manager] = "Yes"))
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: dc64267e-5ae3-42cb-aba5-969810c2f85a

	measure 'On Leave' = CALCULATE([Included Headcount], KEEPFILTERS(Workforce[Worker Status] = "On Leave"))
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: 3582ec36-3ad7-4665-a7fa-51cbf89ea193

	measure 'Part Time Workers' = CALCULATE([Included Headcount], KEEPFILTERS(Workforce[Time Type] = "Part time"))
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: bde1aeb3-78d7-409d-98a5-6559ff3a8a19

	measure 'FTE per Worker' = DIVIDE([Total FTE], [Included Headcount])
		formatString: 0.00
		displayFolder: Workforce Metrics
		lineageTag: 5e8d1bda-c4e3-4430-9735-df1c2a849fd5

	measure 'Capacity Gap' = [Included Headcount] - [Total FTE]
		formatString: #,0.00
		displayFolder: Workforce Metrics
		lineageTag: 95950255-d920-40cd-ad1f-7901c6669e7a

	measure 'Manager Share' = DIVIDE([People Managers], [Included Headcount])
		formatString: 0.0%
		displayFolder: Workforce Metrics
		lineageTag: 193ef70c-323a-4ef2-8acb-6c14b69f2eea

	measure 'Contingent Share' = DIVIDE([Contingent Workers], [Included Headcount])
		formatString: 0.0%
		displayFolder: Workforce Metrics
		lineageTag: fa4c4d63-c5d1-4b5d-9708-d3d2ff4a0d83

	measure 'On Leave Share' = DIVIDE([On Leave], [Included Headcount])
		formatString: 0.0%
		displayFolder: Workforce Metrics
		lineageTag: 4bc07fd5-c63e-47e5-9380-5ad438cb243b

	measure 'Part Time Share' = DIVIDE([Part Time Workers], [Included Headcount])
		formatString: 0.0%
		displayFolder: Workforce Metrics
		lineageTag: b583ed0d-d651-41f4-a6e6-feb9335db226

	measure 'Average Tenure Years' = VAR D = [Selected Snapshot] RETURN CALCULATE(AVERAGE(Workforce[Tenure Years]), Workforce[Snapshot_Date] = D, Workforce[Included] = TRUE(), Workforce[Latest Hire Date] <> BLANK(), Workforce[Tenure Years] >= 0)
		formatString: 0.0
		displayFolder: Workforce Metrics
		lineageTag: d4424573-fd2a-47f1-8d0a-42d736b325e3

	measure 'Median Tenure Years' = VAR D = [Selected Snapshot] RETURN CALCULATE(MEDIAN(Workforce[Tenure Years]), Workforce[Snapshot_Date] = D, Workforce[Included] = TRUE(), Workforce[Latest Hire Date] <> BLANK(), Workforce[Tenure Years] >= 0)
		formatString: 0.0
		displayFolder: Workforce Metrics
		lineageTag: cd2d33be-1c58-4ddf-aedc-efb920495b48

	measure 'Current Workers Hired Last 90 Days' = VAR D = [Selected Snapshot] RETURN CALCULATE([Included Headcount], KEEPFILTERS(Workforce[Latest Hire Date] >= D - 90), KEEPFILTERS(Workforce[Latest Hire Date] <= D))
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: 2325cf02-f581-48f8-ba87-bee4b9bc8993

	measure 'Current Workers Hired YTD' = VAR D = [Selected Snapshot] RETURN CALCULATE([Included Headcount], KEEPFILTERS(Workforce[Latest Hire Date] >= DATE(YEAR(D),1,1)), KEEPFILTERS(Workforce[Latest Hire Date] <= D))
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: 2a6f7280-7d03-4fad-829b-a84358306b9e

	measure Countries = VAR D = [Selected Snapshot] RETURN CALCULATE(DISTINCTCOUNT(Workforce[Work Country]), Workforce[Snapshot_Date] = D, Workforce[Included] = TRUE(), Workforce[Work Country] <> BLANK())
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: 3ffdf6fa-c2c6-45ba-9277-d1ddb2c7f758

	measure 'Cost Centers' = VAR D = [Selected Snapshot] RETURN CALCULATE(DISTINCTCOUNT(Workforce[Cost Center - ID]), Workforce[Snapshot_Date] = D, Workforce[Included] = TRUE(), Workforce[Cost Center - ID] <> BLANK())
		formatString: #,0
		displayFolder: Workforce Metrics
		lineageTag: 2b5f99fd-8fb4-47bc-b1f6-efd370eb1708

