table MonthlyActuals
	column Month
		dataType: string
		sourceColumn: Month
		summarizeBy: none
	column Workstream
		dataType: string
		sourceColumn: Workstream
		summarizeBy: none
	column Country
		dataType: string
		sourceColumn: Country
		summarizeBy: none
	column ActualHC
		dataType: int64
		sourceColumn: ActualHC
		summarizeBy: none
	partition MonthlyActuals = m
		mode: import
		source =
			let
			    Data = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Data, {"Month", "Workstream", "Country", "ActualHC"}),
			    Typed = Table.TransformColumnTypes(Source, {{"Month", type text}, {"Workstream", type text}, {"Country", type text}, {"ActualHC", Int64.Type}}),
			    Keys = Table.Group(Typed, {"Month", "Workstream", "Country"}, {{"N", each Table.RowCount(_), Int64.Type}}),
			    Checked = if Table.RowCount(Table.SelectRows(Keys, each [N] > 1 or [Month] = null or [Workstream] = null or [Country] = null)) > 0 then error "Duplicate or missing monthly keys." else Typed
			in
			    Checked
