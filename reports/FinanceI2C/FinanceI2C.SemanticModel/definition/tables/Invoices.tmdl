table Invoices
	column InvoiceID
		dataType: string
		sourceColumn: InvoiceID
		summarizeBy: none
	column CustomerID
		dataType: string
		sourceColumn: CustomerID
		summarizeBy: none
	column InvoiceDate
		dataType: dateTime
		sourceColumn: InvoiceDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column InvoiceMonth
		dataType: dateTime
		sourceColumn: InvoiceMonth
		summarizeBy: none
		formatString: yyyy-MM-dd
	column DueDate
		dataType: dateTime
		sourceColumn: DueDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column TermsDays
		dataType: int64
		sourceColumn: TermsDays
		summarizeBy: none
	column Amount
		dataType: decimal
		sourceColumn: Amount
		summarizeBy: none
	column DisputeDate
		dataType: dateTime
		sourceColumn: DisputeDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column ClosedDate
		dataType: dateTime
		sourceColumn: ClosedDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column PaidOnTime
		dataType: int64
		sourceColumn: PaidOnTime
		summarizeBy: none
	column IsClosed
		dataType: int64
		sourceColumn: IsClosed
		summarizeBy: none

	partition Invoices = m
		mode: import
		source =
			let
			    Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Rows, {"InvoiceID", "CustomerID", "InvoiceDate", "InvoiceMonth", "DueDate", "TermsDays", "Amount", "DisputeDate", "ClosedDate", "PaidOnTime", "IsClosed"}),
			    Typed = Table.TransformColumnTypes(Source, {{"InvoiceID", type text}, {"CustomerID", type text}, {"InvoiceDate", type date}, {"InvoiceMonth", type date}, {"DueDate", type date}, {"TermsDays", Int64.Type}, {"Amount", Currency.Type}, {"DisputeDate", type date}, {"ClosedDate", type date}, {"PaidOnTime", Int64.Type}, {"IsClosed", Int64.Type}}, "en-US")
			in
			    Typed
