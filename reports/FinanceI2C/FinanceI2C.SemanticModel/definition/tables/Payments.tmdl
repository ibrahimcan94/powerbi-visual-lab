table Payments
	column PaymentID
		dataType: string
		sourceColumn: PaymentID
		summarizeBy: none
	column InvoiceID
		dataType: string
		sourceColumn: InvoiceID
		summarizeBy: none
	column PaymentDate
		dataType: dateTime
		sourceColumn: PaymentDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column PaymentMonth
		dataType: dateTime
		sourceColumn: PaymentMonth
		summarizeBy: none
		formatString: yyyy-MM-dd
	column Amount
		dataType: decimal
		sourceColumn: Amount
		summarizeBy: none

	partition Payments = m
		mode: import
		source =
			let
			    Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Rows, {"PaymentID", "InvoiceID", "PaymentDate", "PaymentMonth", "Amount"}),
			    Typed = Table.TransformColumnTypes(Source, {{"PaymentID", type text}, {"InvoiceID", type text}, {"PaymentDate", type date}, {"PaymentMonth", type date}, {"Amount", Currency.Type}}, "en-US")
			in
			    Typed
