table ARSnapshot
	column InvoiceID
		dataType: string
		sourceColumn: InvoiceID
		summarizeBy: none
	column SnapshotDate
		dataType: dateTime
		sourceColumn: SnapshotDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column OpenAmount
		dataType: decimal
		sourceColumn: OpenAmount
		summarizeBy: none
	column DaysPastDue
		dataType: int64
		sourceColumn: DaysPastDue
		summarizeBy: none
	column AgingBucket
		dataType: string
		sourceColumn: AgingBucket
		summarizeBy: none
		sortByColumn: AgingOrder
	column AgingOrder
		dataType: int64
		sourceColumn: AgingOrder
		summarizeBy: none
	column DisputedAmount
		dataType: decimal
		sourceColumn: DisputedAmount
		summarizeBy: none

	partition ARSnapshot = m
		mode: import
		source =
			let
			    Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Rows, {"InvoiceID", "SnapshotDate", "OpenAmount", "DaysPastDue", "AgingBucket", "AgingOrder", "DisputedAmount"}),
			    Typed = Table.TransformColumnTypes(Source, {{"InvoiceID", type text}, {"SnapshotDate", type date}, {"OpenAmount", Currency.Type}, {"DaysPastDue", Int64.Type}, {"AgingBucket", type text}, {"AgingOrder", Int64.Type}, {"DisputedAmount", Currency.Type}}, "en-US")
			in
			    Typed
