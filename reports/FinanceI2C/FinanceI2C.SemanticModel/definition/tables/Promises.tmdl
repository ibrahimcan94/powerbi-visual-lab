table Promises
	column PromiseID
		dataType: string
		sourceColumn: PromiseID
		summarizeBy: none
	column InvoiceID
		dataType: string
		sourceColumn: InvoiceID
		summarizeBy: none
	column PromiseCreated
		dataType: dateTime
		sourceColumn: PromiseCreated
		summarizeBy: none
		formatString: yyyy-MM-dd
	column PromiseDate
		dataType: dateTime
		sourceColumn: PromiseDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column PromiseMonth
		dataType: dateTime
		sourceColumn: PromiseMonth
		summarizeBy: none
		formatString: yyyy-MM-dd
	column PromiseAmount
		dataType: decimal
		sourceColumn: PromiseAmount
		summarizeBy: none
	column Kept
		dataType: int64
		sourceColumn: Kept
		summarizeBy: none

	partition Promises = m
		mode: import
		source =
			let
			    Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Rows, {"PromiseID", "InvoiceID", "PromiseCreated", "PromiseDate", "PromiseMonth", "PromiseAmount", "Kept"}),
			    Typed = Table.TransformColumnTypes(Source, {{"PromiseID", type text}, {"InvoiceID", type text}, {"PromiseCreated", type date}, {"PromiseDate", type date}, {"PromiseMonth", type date}, {"PromiseAmount", Currency.Type}, {"Kept", Int64.Type}}, "en-US")
			in
			    Typed
