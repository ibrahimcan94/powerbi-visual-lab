table Customers
	column CustomerID
		dataType: string
		sourceColumn: CustomerID
		summarizeBy: none
	column Customer
		dataType: string
		sourceColumn: Customer
		summarizeBy: none
	column Region
		dataType: string
		sourceColumn: Region
		summarizeBy: none
	column Segment
		dataType: string
		sourceColumn: Segment
		summarizeBy: none
	column Collector
		dataType: string
		sourceColumn: Collector
		summarizeBy: none
	column RiskTier
		dataType: string
		sourceColumn: RiskTier
		summarizeBy: none
	column CreditLimit
		dataType: int64
		sourceColumn: CreditLimit
		summarizeBy: none

	partition Customers = m
		mode: import
		source =
			let
			    Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Rows, {"CustomerID", "Customer", "Region", "Segment", "Collector", "RiskTier", "CreditLimit"}),
			    Typed = Table.TransformColumnTypes(Source, {{"CustomerID", type text}, {"Customer", type text}, {"Region", type text}, {"Segment", type text}, {"Collector", type text}, {"RiskTier", type text}, {"CreditLimit", Int64.Type}}, "en-US")
			in
			    Typed
