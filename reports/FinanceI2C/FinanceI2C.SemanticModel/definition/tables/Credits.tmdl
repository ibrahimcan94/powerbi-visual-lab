table Credits
	column CreditID
		dataType: string
		sourceColumn: CreditID
		summarizeBy: none
	column InvoiceID
		dataType: string
		sourceColumn: InvoiceID
		summarizeBy: none
	column CreditDate
		dataType: dateTime
		sourceColumn: CreditDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column CreditMonth
		dataType: dateTime
		sourceColumn: CreditMonth
		summarizeBy: none
		formatString: yyyy-MM-dd
	column Amount
		dataType: decimal
		sourceColumn: Amount
		summarizeBy: none

	partition Credits = m
		mode: import
		source =
			let
			    Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Rows, {"CreditID", "InvoiceID", "CreditDate", "CreditMonth", "Amount"}),
			    Typed = Table.TransformColumnTypes(Source, {{"CreditID", type text}, {"InvoiceID", type text}, {"CreditDate", type date}, {"CreditMonth", type date}, {"Amount", Currency.Type}}, "en-US")
			in
			    Typed
