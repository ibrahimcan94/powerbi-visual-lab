		source =
			#table(type table [EventID = text, InvoiceID = text, Customer = text, Region = text, Segment = text, Collector = text, RiskTier = text, InvoiceDate = date, DueDate = date, EventDate = date, EventType = text, Amount = Currency.Type, DisputeDate = nullable date, PromiseDue = nullable date], {})
