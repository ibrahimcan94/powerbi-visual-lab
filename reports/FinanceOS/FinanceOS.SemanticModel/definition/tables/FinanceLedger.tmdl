table FinanceLedger
	column EventID
		dataType: string
		sourceColumn: EventID
		summarizeBy: none
	column InvoiceID
		dataType: string
		sourceColumn: InvoiceID
		summarizeBy: none
	column Customer
		dataType: string
		sourceColumn: Customer
		summarizeBy: none
	column Region
		dataType: string
		sourceColumn: Region
		summarizeBy: none
	column Segment
		dataType: string
		sourceColumn: Segment
		summarizeBy: none
	column Collector
		dataType: string
		sourceColumn: Collector
		summarizeBy: none
	column RiskTier
		dataType: string
		sourceColumn: RiskTier
		summarizeBy: none
	column InvoiceDate
		dataType: dateTime
		sourceColumn: InvoiceDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column DueDate
		dataType: dateTime
		sourceColumn: DueDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column EventDate
		dataType: dateTime
		sourceColumn: EventDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column EventType
		dataType: string
		sourceColumn: EventType
		summarizeBy: none
	column Amount
		dataType: decimal
		sourceColumn: Amount
		summarizeBy: sum
	column DisputeDate
		dataType: dateTime
		sourceColumn: DisputeDate
		summarizeBy: none
		formatString: yyyy-MM-dd
	column PromiseDue
		dataType: dateTime
		sourceColumn: PromiseDue
		summarizeBy: none
		formatString: yyyy-MM-dd

	partition FinanceLedger = m
		mode: import
		source =
			let
			    Data = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
			    Source = Table.FromRows(Data, {"EventID", "InvoiceID", "Customer", "Region", "Segment", "Collector", "RiskTier", "InvoiceDate", "DueDate", "EventDate", "EventType", "Amount", "DisputeDate", "PromiseDue"}),
			    Typed = Table.TransformColumnTypes(Source, {{"EventID", type text}, {"InvoiceID", type text}, {"Customer", type text}, {"Region", type text}, {"Segment", type text}, {"Collector", type text}, {"RiskTier", type text}, {"InvoiceDate", type date}, {"DueDate", type date}, {"EventDate", type date}, {"EventType", type text}, {"Amount", Currency.Type}, {"DisputeDate", type date}, {"PromiseDue", type date}}, "en-US")
			in
			    Typed
